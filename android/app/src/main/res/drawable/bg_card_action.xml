<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Hard Brutalist Shadow -->
    <item
        android:left="6dp"
        android:top="6dp">
        <shape android:shape="rectangle">
            <solid android:color="#0A0A0A" />
        </shape>
    </item>
    <!-- Main Hero Action Card Body (Rich Gold Yellow) -->
    <item
        android:bottom="6dp"
        android:right="6dp">
        <shape android:shape="rectangle">
            <solid android:color="#FFD600" />
            <stroke
                android:width="3dp"
                android:color="#0A0A0A" />
        </shape>
    </item>
</layer-list>
