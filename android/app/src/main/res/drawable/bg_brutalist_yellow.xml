<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Hard Brutalist Shadow -->
    <item
        android:left="4dp"
        android:top="4dp">
        <shape android:shape="rectangle">
            <solid android:color="#0A0A0A" />
        </shape>
    </item>
    <!-- Gold Yellow Body -->
    <item
        android:bottom="4dp"
        android:right="4dp">
        <shape android:shape="rectangle">
            <solid android:color="#FFD600" />
            <stroke
                android:width="2.5dp"
                android:color="#0A0A0A" />
        </shape>
    </item>
</layer-list>
